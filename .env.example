# Gemini Developer API
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=1.0

# Teams Workflows incoming webhook
TEAMS_WEBHOOK_URL=
TEAMS_DRY_RUN=true
TEAMS_NOTIFY_MIN_SEVERITY=MEDIUM

# Monitoring
POLL_INTERVAL_SECONDS=180
SERVER_ID=jboss-01

# Application
APP_ENV=development
LOG_LEVEL=INFO

# JBoss backend: fake | real
JBOSS_MODE=fake

# Fake MCP server
JBOSS_MCP_TRANSPORT=stdio

# Human-in-the-loop / persistence
CHECKPOINT_BACKEND=memory
CHECKPOINT_DB_PATH=.data/checkpoints.sqlite

# Investigation safety
MAX_INVESTIGATION_ROUNDS=5
MAX_RECOVERY_ATTEMPTS=2
