# Gemini Developer API
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=1.0

# Teams Workflows incoming webhook
TEAMS_WEBHOOK_URL=
TEAMS_DRY_RUN=true
TEAMS_NOTIFY_MIN_SEVERITY=MEDIUM

# Monitoring
POLL_INTERVAL_SECONDS=180
SERVER_ID=jboss-01

# Application
APP_ENV=development
LOG_LEVEL=INFO

# JBoss backend: fake | real
JBOSS_MODE=fake

# Fake MCP server
JBOSS_MCP_TRANSPORT=stdio
FAKE_JBOSS_DATA_DIR=.data/fake_jboss

# Human-in-the-loop / persistence
# STEP 10-12 operational demo always uses durable SQLite. Keeping this value at
# sqlite also makes the STEP 7 CLI persistence behavior intuitive.
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB_PATH=.data/checkpoints.sqlite
RUNTIME_DB_PATH=.data/runtime.sqlite
SIMULATOR_DB_PATH=.data/simulator.sqlite
LANGGRAPH_STRICT_MSGPACK=true

# Investigation safety
MAX_INVESTIGATION_ROUNDS=5
MAX_RECOVERY_ATTEMPTS=2

# Evaluation (STEP 12)
EVALUATION_RUNS=12
EVALUATION_SEED=42
EVALUATION_REPORT_PATH=.data/evaluation_latest.json
